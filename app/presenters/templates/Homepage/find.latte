{block content}
  <form id="findForm">
<select name="dir" id="dirSelect" >
  <option value="">všechny podsložky</option>
  <option n:foreach="$firstLevel as $file" value="{$file}">{$file}</option>
</select>
  Hledaný soubor:<br>
  <input type="text" name="file" id="fileInput"><br>
  <input type="submit" value="Hledat">
</form>

    <div class="row">
    	<div n:snippet=listing class="col-8">
            <ol class="breadcrumb">
            	<li><a n:href="default">Vybrane dokumenty: </a></li>
            	<li>\{$dir}</li>
            </ol>
			<table class="table table-hover">
				<thead>
					<tr class="text-bold bg-primary">
              <th></th>
    					<th class="w-75 p-2">Název souboru</th>
    					<th>Typ</th>
    					<th>Velikost[B]</th>
    					<th>Aktualizace</th>

					</tr>
				</thead>
				<tbody>
    			    <tr n:foreach="$files as $file">
                <td><i class="{$file["imageCssClass"]}"></i></td>
      			    <td><a href={$file["href"]} title={$file["title"]}> {$file["text"]}</a></td>
     					  <td class="text-lowercase"> {$file["ext"]} </td>
      					<td class="text-right"> {$file["size"]} </td>
      					<td class="text-right"> {$file["date"]}</td>
    			    </tr>
				</tbody>
			</table>
    	</div>
    </div>


  <script>
		 $('#findForm').submit (function(event){
			 event.preventDefault();
			 var dir = $('#dirSelect').val();
			 var file = $('#fileInput').val();
			 $.nette.ajax({
					 url: {link find!},
					 data: { dir :  dir, file : file }
			 });

		 });

		 //tree.expandAll();

  </script>

{/block}
