{**
 * @param string   $basePath web base path
 * @param array    $flashes  flash messages
 *}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">

<title>{ifset title}{include title|stripHtml} | {/ifset}Dir lister</title>

<link rel="stylesheet" href="{$basePath}/css/style.css">
<link rel="stylesheet" href="{$basePath}/css/bootstrap.css">
{block scripts}
<script src="{$basePath}/js/jquery.min.js"></script>
	<script src="{$basePath}/js/nette.ajax.js"></script>
		<link rel="stylesheet" href="{$basePath}/css/font-awesome.min.css">
<script src="{$basePath}/js/bootstrap.js"></script>
<script src="https://unpkg.com/gijgo@1.9.13/js/gijgo.min.js" type="text/javascript"></script>
<link href="https://unpkg.com/gijgo@1.9.13/css/gijgo.min.css" rel="stylesheet" type="text/css" />

<script src="{$basePath}/js/main.js"></script>
{/block}
	{block head}{/block}

</head>

<body>
	

    <div class="top-header-wrapper">
        <div class="container">
            <img src="{$basePath}/images/fnol-logo-intranet.png" alt="" title="" height="75"/>
            <span class="text-right text-intranet">Intranet&nbsp;&nbsp;FN Olomouc</span>
        </div>
        <div class="container">&nbsp;</div>
    </div>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <div class="navbar-header">
                <span class="text-right">BezpListy</span>
                <a class="navbar-brand" n:href="Homepage:default"><span class="fa fa-home"></span></a>
                <a class="navbar-brand" n:href="Homepage:find">Hledat</span></a>
            </div>
        </div>
    </nav>
    <br/>

	<div class="container">
		<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type">{$flash->message}</div>
		{include content}
	</div>
    <br/>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-sm-6 text-left">
                    {date('Y')} &copy; FN Olomouc
                </div>
                <div class="col-sm-6 text-right">
                    i-Tree ver. 1.1&nbsp;
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
